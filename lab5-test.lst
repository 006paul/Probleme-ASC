     1                                  bits 32 
     2                                  global start        
     3                                  extern exit
     4                                  import exit msvcrt.dll
     5                                                            
     6                                  segment data use32 class=data
     7                                  	; signed representation
     8                                      	; x/2+100*(a+b)-3/(c+d)+e*e = 225 = E1h; a,c-word; b,d-byte; e-doubleword; x-qword
     9                                          ; 20/2+100*(1+1)-3/(2+1)+4*4
    10 00000000 0100                    	a dw 1
    11 00000002 0200                    	c dw 2
    12                                  	
    13 00000004 01                      	b db 1
    14 00000005 01                      	d db 1
    15                                  	
    16 00000006 04000000                	e dd 4
    17 0000000A 1400000000000000        	x dq 20
    18                                      
    19                                  ; our code starts here
    20                                  segment code use32 class=code
    21                                      start:
    22                                  		; x/2+100*(a+b)-3/(c+d)+e*e; a,c-word; b,d-byte; e-doubleword; x-qword
    23 00000000 A0[04000000]            		mov AL, [b]         ; al = b
    24 00000005 6698                    		cbw                 ; ax = b
    25 00000007 660305[00000000]        		add AX, [a]         ; ax = a + b
    26 0000000E 66BB6400                		mov BX, 100         ; bl = 100
    27 00000012 66F7EB                  		imul BX             ; dx:ax = 100*(a+b)
    28 00000015 6652                    		push DX
    29 00000017 6650                    		push AX      
    30 00000019 A0[05000000]            		mov AL, [d]         ; al = d
    31 0000001E 6698                    		cbw                 ; ax = d
    32 00000020 660305[02000000]        		add AX, [c]         ; ax = c + d
    33 00000027 6689C3                  		mov BX, AX          ; bx = c + d
    34 0000002A 66B80300                		mov AX, 3   
    35 0000002E 6699                    		cwd                 ; dx:ax = 3
    36 00000030 66F7FB                  		idiv BX             ; ax = 3/(c+d)
    37 00000033 98                      		cwde                ; eax = 3/(c+d)
    38 00000034 5B                      		pop EBX             ; ebx = 100*(a+b)
    39 00000035 29C3                    		sub EBX, EAX        ; ebx = 100*(a+b)-3/(c+d)
    40 00000037 53                      		push EBX    
    41 00000038 A1[0A000000]            		mov EAX, [x]
    42 0000003D 8B15[0E000000]          		mov EDX, [x + 4]    ; edx:eax = x
    43 00000043 BB02000000                      mov ebx, 2
    44 00000048 F7FB                    		idiv ebx            ; eax = x/2
    45 0000004A 59                      		pop ECX             ; ecx = 100*(a+b)-3/(c+d)
    46 0000004B 01C8                    		add EAX, ECX        ; eax = x/2+100*(a+b)-3/(c+d)
    47 0000004D 99                      		cdq                 ; edx:eax = x/2+100*(a+b)-3/(c+d)       
    48 0000004E 52                      		push EDX 
    49 0000004F 50                      		push EAX
    50 00000050 A1[06000000]            		mov EAX, [e]        ; eax = e
    51 00000055 F72D[06000000]          		imul dword [e]      ; edx:eax = e*e
    52 0000005B 5B                      		pop ebx
    53 0000005C 59                              pop ecx             ; ecx:ebx = x/2+100*(a+b)-3/(c+d) 
    54 0000005D 01D8                    		add EAX, EBX
    55 0000005F 11CA                    		adc EDX, ECX        ; edx:eax = x/2+100*(a+b)-3/(c+d)+e*e
    56                                  		
    57                                          ; exit(0)
    58 00000061 6A00                            push    dword 0      ; push the parameter for exit onto the stack
    59 00000063 FF15[00000000]                  call    [exit]       ; call exit to terminate the program
