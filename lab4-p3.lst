    33 0000002D 09C3                            or ebx, eax ; ebx = ...100111001
    34                                      
    35 0000002F B800000000                      mov eax, 0
    36 00000034 66A1[00000000]                  mov ax, [a]
    37 0000003A 25F8030000                      and eax, 000003f8h
