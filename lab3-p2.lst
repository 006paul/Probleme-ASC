     1                                  bits 32 ; assembling for the 32 bits architecture
     2                                  
     3                                  ; declare the EntryPoint (a label defining the very first instruction of the program)
     4                                  global start        
     5                                  
     6                                  ; declare external functions needed by our program
     7                                  extern exit               ; tell nasm that exit exists even if we won't be defining it
     8                                  import exit msvcrt.dll    ; exit is a function that ends the calling process. It is defined in msvcrt.dll
     9                                                            ; msvcrt.dll contains exit, printf and all the other important C-runtime specific functions
    10                                  
    11                                  ; our data is declared here (the variables needed by our program)
    12                                  segment data use32 class=data
    13                                      ; (8-a*b*100+c)/d+x; a,b,d-byte; c-doubleword; x-qword
    14 00000000 03                          a db 3
    15 00000001 04                          b db 4
    16 00000002 05000000                    c dd 5
    17 00000006 02                          d db 2
    18 00000007 0400000000000000            x dq 4
    19                                  
    20                                  ; our code starts here
    21                                  segment code use32 class=code
    22                                      start:
    23 00000000 B064                            mov al, 100
    24 00000002 F62D[00000000]                  imul byte [a] ; ax = a*100
    25 00000008 6650                            push ax       ; stiva ax = a*100
    26 0000000A A0[01000000]                    mov al, [b]
    27 0000000F 6698                            cbw           ; ax = b (word)
    28 00000011 665B                            pop bx        ; bx = a*100
    29 00000013 66F7EB                          imul word bx  ; dx:ax = a*b*100
    30 00000016 6652                            push dx
    31 00000018 6650                            push ax       ; stiva dx:ax = a*b*100
    32 0000001A 58                              pop eax       ; eax = a*b*100
    33 0000001B BB08000000                      mov ebx, 8
    34 00000020 29C3                            sub dword ebx, eax  ; ebx = 8 - a*b*100
    35 00000022 031D[02000000]                  add ebx, [c]        ; ebx = 8 - a*b*100 + c
    36 00000028 A0[06000000]                    mov al, [d]         ; al = d
    37 0000002D 6698                            cbw                 ; ax = d
    38 0000002F 6689C1                          mov cx, ax          ; cx = d
    39 00000032 53                              push ebx
    40 00000033 6658                            pop ax
    41 00000035 665A                            pop dx              ; dx:ax = ebx = 8 - a*b*100 + c
    42 00000037 66F7F9                          idiv cx             ; ax = (8-a*b*100+c)/d
    43 0000003A 98                              cwde                ; eax = 
    44 0000003B 99                              cdq                 ; edx:eax = 
    45 0000003C 0305[07000000]                  add eax, [x]
    46 00000042 1315[0B000000]                  adc edx, [x+4]      ; edx:eax = (8-a*b*100+c)/d+x
    47 00000048 6A00                            push    dword 0      ; push the parameter for exit onto the stack
    48 0000004A FF15[00000000]                  call    [exit]       ; call exit to terminate the program
