     1                                  bits 32
     2                                  global start
     3                                  extern exit
     4                                  import exit msvcrt.dll
     5                                  
     6                                  segment data use32 class=data
     7                                      ; (a+d-c)-(b+b)
     8 00000000 05                          a db 5
     9 00000001 02                          b db 2
    10 00000002 03                          c db 3
    11 00000003 08                          d db 8
    12                                  segment code use32 class=code
    13                                  start:
    14 00000000 A0[00000000]                mov al, [a]
    15 00000005 0205[03000000]              add al, [d] ; al = a + d
    16 0000000B 2A05[02000000]              sub al, [c] ; al = a + d - c
    17 00000011 8A1D[01000000]              mov bl, [b]
    18 00000017 021D[01000000]              add bl, [b] ; bl = b + b
    19 0000001D 28D8                        sub al, bl  ; al = (a+d-c)-(b+b)
    20                                      
    21 0000001F 6A00                        push dword 0
    22 00000021 FF15[00000000]              call [exit]
