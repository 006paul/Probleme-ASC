     1                                  bits 32
     2                                  
     3                                  global start
     4                                  
     5                                  extern exit
     6                                  import exit msvcrt.dll
     7                                  
     8                                  segment data use32 class=data
     9                                      ; a/2+b*b-a*b*c+e+x; a,b,c-byte; e-doubleword; x-qword
    10 00000000 03                          a db 3
    11 00000001 FE                          b db -2
    12 00000002 FF                          c db -1
    13 00000003 0A000000                    e dd 10
    14 00000007 0C00000000000000            x dq 12
    15                                  segment code use32 class=code
    16                                      start:
    17 00000000 A0[00000000]                    mov al, [a]     ; al = a
    18 00000005 6698                            cbw             ; ax = a
    19 00000007 B302                            mov bl, 2       
    20 00000009 F6FB                            idiv bl         ; al = a/2
    21                                          
    22 0000000B 88C3                            mov bl, al      ; bl = a/2
    23 0000000D A0[01000000]                    mov al, [b]
    24 00000012 F62D[01000000]                  imul byte [b]   ; ax = b*b
    25                                          
    26 00000018 6689C1                          mov cx, ax      ; cx = b*b
    27 0000001B 88D8                            mov al, bl      ; al = a/2
    28 0000001D 6698                            cbw             ; ax = a/2
    29 0000001F 6601C1                          add cx, ax      ; cx = a/2 + b*b
    30                                          
    31 00000022 A0[00000000]                    mov al, [a]     ; al = a
    32 00000027 F62D[01000000]                  imul byte [b]   ; ax = a*b
    33 0000002D 6689C3                          mov bx, ax      ; bx = a*b
    34 00000030 A0[02000000]                    mov al, [c]
    35 00000035 6698                            cbw             ; ax = c
    36 00000037 66F7EB                          imul bx         ; dx:ax = a*b*c
    37                                          
    38 0000003A 6652                            push dx
    39 0000003C 6650                            push ax
    40 0000003E 58                              pop eax         ; eax = a*b*c
    41 0000003F 89C3                            mov ebx, eax    ; ebx = a*b*c
    42 00000041 6689C8                          mov ax, cx      ; ax = a/2 + b*b
    43 00000044 98                              cwde            ; eax = a/2 + b*b
    44 00000045 29D8                            sub eax, ebx    ; eax = a/2 + b*b - a*b*c
    45                                          
    46 00000047 0305[03000000]                  add eax, [e]    ; eax = a/2 + b*b - a*b*c + e
    47                                          
    48 0000004D 99                              cdq             ; edx:eax = a/2 + b*b - a*b*c + e
    49 0000004E 8B1D[07000000]                  mov ebx, [x]
    50 00000054 8B0D[0B000000]                  mov ecx, [x+4]  ; ecx:ebx = x
    51 0000005A 01D8                            add eax, ebx
    52 0000005C 11CA                            adc edx, ecx    ; edx:eax = a/2+b*b-a*b*c+e+x
    53 0000005E 6A00                            push dword 0
    54 00000060 FF15[00000000]                  call [exit]
